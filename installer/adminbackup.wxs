<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util" xmlns:firewall="http://wixtoolset.org/schemas/v4/wxs/firewall">
	<?include adminbackup.wxi?>
	<Package Name="AdminBackup" Language="1033" Version="$(var.Version)" Manufacturer="A.D.M.I.N (4dmin.pl)" UpgradeCode="4C57D549-8A81-5E12-B12D-740EBB38D0C8" InstallerVersion="301"><SummaryInformation Description="AdminBackup - kopie zapasowe A.D.M.I.N" Manufacturer="A.D.M.I.N (4dmin.pl)" />
			 
	<MajorUpgrade DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit." />
	
    <Media Id="1" Cabinet="urbackup.cab" EmbedCab="yes" />
	
	<?if $(var.Platform)=x64 ?>
	<Launch Condition="Msix64" Message="You are attempting to run the 32-bit installer on a 64-bit version of Windows." />
	<?endif?>
	
	
	<util:CloseApplication Id="CloseUrBackupClient" CloseMessage="yes" ElevatedCloseMessage="no" RebootPrompt="no" Target="UrBackupClient.exe" />

						   
    
		
	 
	<WixVariable Id="WixUIDialogBmp" Value="$(var.Brand)\WixUIDialogBmp.bmp" />
	<WixVariable Id="WixUIBannerBmp" Value="$(var.Brand)\WixUIBannerBmp.bmp" />
	
	<Property Id="WIXUI_INSTALLDIR" Value="URBACKUPDIR" />
	<UIRef Id="WixUI_InstallDirCustom" />
	
	<Icon Id="backup_ok_ico" SourceFile="$(var.shared_data_dir)\backup-ok.ico" />
	<Property Id="ARPPRODUCTICON" Value="backup_ok_ico" />
	<Property Id="ARPHELPLINK" Value="https://4dmin.pl/" />
	
	<Property Id="WixShellExecTarget" Value="[#UrBackupClient.exe]" />
	<CustomAction Id="LaunchApplication" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_X86" />
	<CustomAction Id="UninstallShellKeys" Execute="deferred" Return="asyncWait" ExeCommand="deleteshellkeys" FileRef="UrBackupClient.exe" />
	
    <Feature Id="urbackup_client" Title="AdminBackup" Level="1">
      <ComponentRef Id="urbackup_client" />
	  <ComponentGroupRef Id="CommonFiles" />
	  <ComponentRef Id="InstallService" />
	  <ComponentRef Id="UrBackupClientAutostart" />
    </Feature>

  
      <Directory Id="$(var.ProgramFilesFolder)" Name="PFiles">
        <Directory Id="URBACKUPDIR" Name="AdminBackup">
			<Component Id="urbackup_client" Guid="$(var.ComponentID)" Bitness="$(var.isx64)">
					<File Id="args" Name="args.txt" DiskId="1" Source="$(var.shared_data_dir)\args.txt" />
					<File Id="prefilebackup_new.bat" DiskId="1" Name="prefilebackup_new.bat" Source="$(var.shared_data_dir)\prefilebackup_new.bat" />
					<File Id="scrub_disk.bat" DiskId="1" Name="scrub_disk.bat" Source="$(var.shared_data_dir)\scrub_disk.bat" />
					<File Id="cryptoplugin.dll" DiskId="1" Name="cryptoplugin.dll" Source="$(var.datadir)\cryptoplugin.dll" />
					<File Id="fileservplugin.dll" DiskId="1" Name="fileservplugin.dll" Source="$(var.datadir)\fileservplugin.dll" />
					<File Id="fsimageplugin.dll" DiskId="1" Name="fsimageplugin.dll" Source="$(var.datadir)\fsimageplugin.dll" />
					<File Id="urbackup.dll" DiskId="1" Name="urbackup.dll" Source="$(var.datadir)\urbackup.dll" />
					<File Id="UrBackupClient.exe" DiskId="1" Name="UrBackupClient.exe" Source="$(var.datadir)\UrBackupClient.exe" />
					<File Id="UrBackupClient_cmd.exe" DiskId="1" Name="UrBackupClient_cmd.exe" Source="$(var.datadir)\UrBackupClient_cmd.exe" />
					<File Id="crt_concrt140_dll" DiskId="1" Name="concrt140.dll" Source="$(var.CrtDir)\concrt140.dll" />
					<File Id="crt_msvcp140_dll" DiskId="1" Name="msvcp140.dll" Source="$(var.CrtDir)\msvcp140.dll" />
					<File Id="crt_msvcp140_1_dll" DiskId="1" Name="msvcp140_1.dll" Source="$(var.CrtDir)\msvcp140_1.dll" />
					<File Id="crt_msvcp140_2_dll" DiskId="1" Name="msvcp140_2.dll" Source="$(var.CrtDir)\msvcp140_2.dll" />
					<File Id="crt_msvcp140_atomic_wait_dll" DiskId="1" Name="msvcp140_atomic_wait.dll" Source="$(var.CrtDir)\msvcp140_atomic_wait.dll" />
					<File Id="crt_msvcp140_codecvt_ids_dll" DiskId="1" Name="msvcp140_codecvt_ids.dll" Source="$(var.CrtDir)\msvcp140_codecvt_ids.dll" />
					<File Id="crt_vccorlib140_dll" DiskId="1" Name="vccorlib140.dll" Source="$(var.CrtDir)\vccorlib140.dll" />
					<File Id="crt_vcruntime140_dll" DiskId="1" Name="vcruntime140.dll" Source="$(var.CrtDir)\vcruntime140.dll" />
					<File Id="crt_vcruntime140_1_dll" DiskId="1" Name="vcruntime140_1.dll" Source="$(var.CrtDir)\vcruntime140_1.dll" />
					<File Id="crt_vcruntime140_threads_dll" DiskId="1" Name="vcruntime140_threads.dll" Source="$(var.CrtDir)\vcruntime140_threads.dll" />
					
			</Component>
			
            <Component Id="InstallService" Guid="FBE5843D-A29F-5372-84FB-48FC16B2906D" Bitness="$(var.isx64)">
				<File Id="WindowsService" Name="UrBackupClientBackend.exe" Source="$(var.datadir)\UrBackupClientBackend.exe" KeyPath="yes">
					<firewall:FirewallException Id="ServiceFirewallException" Name="AdminBackup" Scope="any" Profile="all" />
				</File>
				  
				  
				  
				<ServiceInstall Id="ServiceInstaller" Type="ownProcess" Vital="yes" Name="UrBackupClientBackend" DisplayName="AdminBackup - usługa kopii zapasowych" Description="Kopie zapasowe plików i obrazów dysków (A.D.M.I.N, 4dmin.pl)" Start="auto" Account="LocalSystem" ErrorControl="ignore" Interactive="no">
					</ServiceInstall>
					<ServiceControl Id="StartService" Start="install" Stop="both" Remove="uninstall" Name="UrBackupClientBackend" Wait="yes" />
				
			</Component>
			
        </Directory>
      </Directory>
    </Package>
  
